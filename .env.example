# Public browser config: use the Supabase Project URL and anon/publishable public key.
# Row Level Security in supabase/schema.sql restricts data to the signed-in owner.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only AI secrets: add as private Vercel Environment Variables.
# Free-tier availability and quotas are controlled by each provider and may change.
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
